# Copy to web/.env.local for local development. On Fly, fly.toml [env] and secrets set these.

# Postgres. Local: docker compose up -d db (port 5433). Fly: set by `fly mpg attach`.
DATABASE_URL=postgresql://ams:ams@localhost:5433/ams

# Sign-in. Empty locally = no sign-in page; pick who you are from the "Working as" menu.
# On Fly the app refuses to run open: scripts/fly-deploy.sh and scripts/fly-users.sh manage this.
# Format: name:password,name:password   (names are usernames in Admin > Users)
BASIC_AUTH_USERS=
# Signs the session cookie. Derived from BASIC_AUTH_USERS when empty; set it in production.
SESSION_SECRET=

# Public origin(s), canonical first, comma separated. Same-origin checks and links in PDFs use it.
PUBLIC_BASE_URL=

# Inbound email (docs/INBOUND_EMAIL.md): forwarded emails become tasks.
INBOUND_EMAIL_TOKEN=local-inbound-token
INBOUND_EMAIL_DOMAIN=amsinbox.siryous.app
# The provider's own server name in Authentication-Results. Unset: no sender counts as verified.
# test.local is what scripts/send-test-email.sh writes; never use it on a deployment.
INBOUND_AUTHSERV_ID=test.local
# INBOUND_TRUST_RECEIVED_SPF=1

# POST /api/cron/daily with this token to run daily automation on a schedule
# (it also runs on the first page view of each day).
CRON_TOKEN=local-cron-token

# The agency's working day.
DISPLAY_TZ=America/New_York

# Optional: Claude for email classification, policy checking, statement reading and account Q&A.
# Without it the app uses its keyword rules and the AI buttons explain they are off.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# ASSISTANT_MODEL=claude-opus-5-5   # the AI Assistant only; defaults to AI_MODEL

# Outbound email. Until set, replies and certificate deliveries are logged, not sent.
# Postmark: smtp://<server token>:<server token>@smtp.postmarkapp.com:587
# SMTP_URL=
# ACCESS_REQUEST_TO=darryl@siryous.com   # who receives requests for a login from the sign-in page
# MAIL_FROM="siryous AMS <access@amsinbox.siryous.app>"   # who the app's own notices come from

# Fill an empty database with the demo agency on boot (docker compose and Fly).
# SEED_ON_EMPTY=1
